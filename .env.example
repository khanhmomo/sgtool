# ── Sportograf TL Tool ──────────────────────────────────────────────────────
# Copy to .env.local and fill in real values. Never commit real secrets.

# MongoDB connection string (Atlas or local)
# e.g. mongodb+srv://user:pass@cluster0.mongodb.net/sportograf-tl
MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/sportograf-tl"

# Auth.js secret — generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET="generate-a-long-random-string"

# Canonical app URL — used in emails and by Auth.js on Vercel.
# Leave unset locally (falls back to request host).
AUTH_URL="https://sgtool.vercel.app"

# Vercel Blob storage for file uploads (PDF/images/GPX).
# When unset in local dev, files are stored under public/uploads instead.
# Create a Blob store in the Vercel dashboard and copy the token.
BLOB_READ_WRITE_TOKEN=""

# Gmail SMTP — welcome emails when admin creates TL accounts.
# GMAIL_USER: the Gmail address sending the mail.
# GMAIL_APP_PASSWORD: an App Password (myaccount.google.com/apppasswords —
# requires 2FA on the Google account). NOT your normal Gmail password.
# Without these, account creation still works (UI warns email wasn't sent).
GMAIL_USER="youremail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
